# YOLO Stream Detection Service Configuration

# Model Configuration
MODEL_PATH=yolo11n.pt

# Service Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Data Storage
LIVE_DATA_FILE=live_data.json

# Detection Settings
DETECTION_CONFIDENCE_THRESHOLD=0.5
TARGET_CLASS=0  # 0 = person

# Video Stream Settings
DEFAULT_VIDEO_SOURCE=0  # 0 = default camera
FRAME_PROCESSING_DELAY=0.033  # ~30 FPS (seconds)

# Logging Configuration
LOG_FILE=service.log
MAX_LOG_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5